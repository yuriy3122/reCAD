{
  "version": 10,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 3,
    "patch": 1
  },
  "configurePresets": [
    {
      "name": "vs2026",
      "displayName": "Visual Studio 2026 x64 + CUDA 13.2",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "toolset": {
        "value": "host=x64,cuda=C:\\Program Files\\NVIDIA GPU Computing Toolkit\\CUDA\\v13.2",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build/vs2026",
      "cacheVariables": {
        "CMAKE_CUDA_ARCHITECTURES": "120",
        "CMAKE_PREFIX_PATH": "${sourceDir}/.deps/installed/x64-windows",
        "RECAD_VCPKG_ROOT": "${sourceDir}/.deps/installed/x64-windows",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "vs2026",
      "configuration": "Release",
      "jobs": 0
    },
    {
      "name": "debug",
      "configurePreset": "vs2026",
      "configuration": "Debug",
      "jobs": 0
    }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "vs2026",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
